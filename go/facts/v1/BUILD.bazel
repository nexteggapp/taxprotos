# Checks that every element of the facts schemas, and of the three forms
# added with them, has a doc comment. It parses the .proto sources, since
# compiled descriptors carry no comments, and resolves their imports from the
# descriptors the Go packages register.
go_test(
    name = "v1_test",
    size = "small",
    srcs = ["documented_test.go"],
    data = [
        "//facts/v1:documents.proto",
        "//facts/v1:tax_year_facts.proto",
        "//us/federal/v1/form_1095_a:form_1095_a.proto",
