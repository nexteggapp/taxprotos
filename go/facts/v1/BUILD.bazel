# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

go_proto_library(
    name = "facts_go_proto",
    importpath = "github.com/nexteggapp/taxprotos/go/facts/v1",
    proto = "//facts/v1:facts_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//go/common/v1",
        "//go/us/federal/v1/form_1040",
        "//go/us/federal/v1/form_1098",
        "//go/us/federal/v1/form_1099_b",
        "//go/us/federal/v1/form_1099_div",
        "//go/us/federal/v1/form_1099_g",
        "//go/us/federal/v1/form_1099_int",
        "//go/us/federal/v1/form_1099_k",
        "//go/us/federal/v1/form_1099_nec",
        "//go/us/federal/v1/form_1099_r",
        "//go/us/federal/v1/form_ssa_1099",
        "//go/us/federal/v1/form_w2",
        "//go/us/federal/v1/form_w2g",
        "//go/us/state/ca/v1/form_540",
        "//go/us/state/or/v1/form_or40",
    ],
)

go_library(
    name = "v1",
    embed = [":facts_go_proto"],
    importpath = "github.com/nexteggapp/taxprotos/go/facts/v1",
    visibility = ["//visibility:public"],
)

# Checks that every element of the facts schemas, and of the three forms
# added with them, has a doc comment. It parses the .proto sources, since
# compiled descriptors carry no comments, and resolves their imports from the
# descriptors the Go packages register.
go_test(
    name = "v1_test",
    size = "small",
    srcs = ["documented_test.go"],
    data = [
        "//facts/v1:documents.proto",
        "//facts/v1:tax_year_facts.proto",
        "//us/federal/v1/form_1099_g:form_1099_g.proto",
        "//us/federal/v1/form_ssa_1099:form_ssa_1099.proto",
        "//us/federal/v1/form_w2g:form_w2g.proto",
    ],
    deps = [
        ":v1",
        "@com_github_bufbuild_protocompile//:protocompile",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@rules_go//go/runfiles",
    ],
)
