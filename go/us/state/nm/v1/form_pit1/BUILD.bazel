# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

go_proto_library(
    name = "form_pit1_go_proto",
    importpath = "github.com/nexteggapp/taxprotos/go/us/state/nm/v1/form_pit1",
    proto = "//us/state/nm/v1/form_pit1:form_pit1_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//go/common/v1",
    ],
)

go_library(
    name = "form_pit1",
    embed = [":form_pit1_go_proto"],
    importpath = "github.com/nexteggapp/taxprotos/go/us/state/nm/v1/form_pit1",
    visibility = ["//visibility:public"],
)

go_test(
    name = "form_pit1_test",
    size = "small",
    srcs = ["coverage_test.go"],
    data = ["//us/state/nm/v1/form_pit1:test_oracles"],
    deps = [
        ":form_pit1",
        "//go/common/v1",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@rules_go//go/runfiles",
    ],
)
