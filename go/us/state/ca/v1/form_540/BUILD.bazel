# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

go_proto_library(
    name = "form_540_go_proto",
    importpath = "github.com/nexteggapp/taxprotos/go/us/state/ca/v1/form_540",
    proto = "//us/state/ca/v1/form_540:form_540_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//go/common/v1",
    ],
)

go_library(
    name = "form_540",
    embed = [":form_540_go_proto"],
    importpath = "github.com/nexteggapp/taxprotos/go/us/state/ca/v1/form_540",
    visibility = ["//visibility:public"],
)

# The mappings and extracts live with the schemas, so they arrive through a
# filegroup rather than a glob of this package.
go_test(
    name = "form_540_test",
    size = "small",
    srcs = ["coverage_test.go"],
    data = ["//us/state/ca/v1/form_540:test_oracles"],
    deps = [
        ":form_540",
        "//go/common/v1",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@rules_go//go/runfiles",
    ],
)
