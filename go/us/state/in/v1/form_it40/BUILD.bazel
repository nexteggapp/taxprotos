# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

go_proto_library(
    name = "form_it40_go_proto",
    importpath = "github.com/nexteggapp/taxprotos/go/us/state/in/v1/form_it40",
    proto = "//us/state/in/v1/form_it40:form_it40_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//go/common/v1",
    ],
)

go_library(
    name = "form_it40",
    embed = [":form_it40_go_proto"],
    importpath = "github.com/nexteggapp/taxprotos/go/us/state/in/v1/form_it40",
    visibility = ["//visibility:public"],
