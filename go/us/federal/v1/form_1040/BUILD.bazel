# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

go_proto_library(
    name = "form_1040_go_proto",
    importpath = "github.com/nexteggapp/taxprotos/go/us/federal/v1/form_1040",
    proto = "//us/federal/v1/form_1040:form_1040_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//go/common/v1",
    ],
)

go_library(
    name = "form_1040",
    embed = [":form_1040_go_proto"],
    importpath = "github.com/nexteggapp/taxprotos/go/us/federal/v1/form_1040",
    visibility = ["//visibility:public"],
)

# The mappings and the form extracts they are checked against. The test reads
# the real mapping files rather than fixtures written to fit the shape it is
# testing, so the data comes from the schema package rather than from here.
go_test(
    name = "form_1040_test",
    size = "small",
    srcs = ["coverage_test.go"],
    data = ["//us/federal/v1/form_1040:test_oracles"],
    deps = [
        ":form_1040",
        "//go/common/v1",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@rules_go//go/runfiles",
    ],
)
