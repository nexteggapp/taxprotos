# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for AR2210.
#
# Lines come from the 2025 form in testdata/, which is pdftotext -layout over
# the PDF the Arkansas Department of Finance and
# Administration publishes. The coverage test checks every
# line named here against that extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a return is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.
#
# Part I's exception is entered on a blank line with no number, so it is not
# mapped. The columns of Part III are mapped in mapping_part_iii.textproto.

form: "AR2210"
message_name: "nexteggapp.taxprotos.us.state.ar.v1.FormAr2210"
tax_years: 2025

concepts {
  concept: "current_year_net_tax"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "total_tax_withheld"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "net_tax_after_withholding"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "prior_year_net_tax"
  years { tax_year: 2025 irs_box: "5" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "6" }
}

concepts {
  concept: "estimated_tax_penalty"
  years { tax_year: 2025 irs_box: "17" }
}
