# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form AR1000F calls each concept, per tax year.
#
# Lines come from the 2025 Form AR1000F as the Arkansas Department of Finance
# and Administration publishes it. There are no amount codes: IRS Publication
# 1220 covers the information returns the IRS receives electronically, and a
# state return is not one of them.
#
# Lines 7A and 7B each print a count and an amount; both are mapped to the
# line, with a note saying which figure each is. Amounts are column A's.

form: "AR1000F"
message_name: "nexteggapp.taxprotos.us.state.ar.v1.FormAR1000F"
tax_years: 2025

concepts {
  concept: "tax_table"
  years { tax_year: 2025 irs_box: "26" }
}
concepts {
