# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form AR1000F: the return a full-year Arkansas resident files.
proto_library(
    name = "form_ar1000f_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_ar1000f.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ar/v1/form_ar1000f.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ar/v1/form_ar1000f:__pkg__"],
)
