# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 1040ME calls each concept, per tax year.
#
# Lines come from the 2025 Form 1040ME as Maine Revenue Services publishes it.
# There are no amount codes: IRS Publication 1220 covers the information
# returns the IRS receives electronically, and a state return is not one of
# them.
#
# The form prints lines 25b to 25f and 34a and 34b only after a run of leader
# dots, and their parts as a bare "b." to "f." beside the number, so they never
# appear set off by whitespace. They are mapped to lines 25 and 34 with a note
# saying which part they are. Lines 12a to 12d are check boxes printed beside
# their labels; they are mapped to line 12.

form: "1040ME"
message_name: "nexteggapp.taxprotos.us.state.me.v1.Form1040ME"
tax_years: 2025
concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "3" note: "Lines 3 to 7: single, married filing jointly, married filing separately, head of household, qualifying surviving spouse." }
}
concepts {
  concept: "age_65_or_older"
  years { tax_year: 2025 irs_box: "12" note: "Lines 12a and 12c: you, and your spouse, 65 or over." }
}
