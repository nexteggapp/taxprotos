# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Georgia Form 500 calls each concept, per tax year.
#
# Lines come from the 2025 Form 500 as the Georgia Department of Revenue prints
# it in the IT-511 booklet. There are no amount codes: IRS Publication 1220
# covers the information returns the IRS receives electronically, and a state
# return is not one of them.

form: "500"
message_name: "nexteggapp.taxprotos.us.state.ga.v1.Form500"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    irs_box: "5"
    note: "Letters A to D: single, married filing jointly, married filing separately, head of household or qualifying surviving spouse."
