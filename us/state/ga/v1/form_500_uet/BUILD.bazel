# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form 500 UET: underpayment of estimated tax.
proto_library(
    name = "form_500_uet_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_500_uet.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ga/v1/form_500_uet.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ga/v1/form_500_uet:__pkg__"],
)
