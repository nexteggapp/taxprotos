# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 740 calls each concept, per tax year.
#
# Lines come from the 2025 Form 740 as the Kentucky Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# Line 21 carries both the family size credit percentage and the credit, so
# both concepts say which they are. Line 25 is reserved. The fund contributions
# on lines 38a to 38k are kept only as their total on line 39.

form: "740"
message_name: "nexteggapp.taxprotos.us.state.ky.v1.Form740"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "1" note: "Filing status boxes 1 to 4; the box number is the status." }
}
concepts {
  concept: "federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "5" note: "Federal Form 1040 line 11a." }
}
