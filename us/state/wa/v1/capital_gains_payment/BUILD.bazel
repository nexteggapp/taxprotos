# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# The payment of Washington's capital gains tax, with its late payment
# penalty and interest. There is no printed form.
proto_library(
    name = "capital_gains_payment_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "capital_gains_payment.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mappings and the form extract they are checked against, for
# //go/us/state/wa/v1/capital_gains_payment.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping*.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/wa/v1/capital_gains_payment:__pkg__"],
)
