# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Montana Form 2 calls each concept, per tax year.
#
# Lines come from the 2025 Form 2 (2025v3) as the Montana Department of Revenue
# publishes it. The tax worksheet on page 2 numbers its lines 1 to 13 again;
# every concept carries a note saying whether it is page 1 or the worksheet.

form: "MT-2"
message_name: "nexteggapp.taxprotos.us.state.mt.v1.Form2"
tax_years: 2025

concepts {
