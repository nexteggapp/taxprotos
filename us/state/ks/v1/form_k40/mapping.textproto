# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form K-40 calls each concept, per tax year.
#
# Lines come from the 2025 Form K-40 as the Kansas Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# The form prints its line numbers with a trailing full stop. The exemption
# boxes on page 1 have no numbers; their concepts carry no line and a note
# naming the box.

form: "K-40"
message_name: "nexteggapp.taxprotos.us.state.ks.v1.FormK40"
tax_years: 2025

concepts {
  concept: "personal_exemption"
  years { tax_year: 2025 note: "Page 1, Exemptions and Dependents: $9,160, or $18,320 married filing jointly." }
}

concepts {
  concept: "head_of_household_exemption"
  years { tax_year: 2025 note: "Page 1, the Head of Household box: $2,320." }
}

concepts {
  concept: "dependent_exemption"
  years { tax_year: 2025 note: "Page 1, the dependents box: $2,320 for each dependent." }
}

concepts {
  concept: "newborn_dependent_exemption"
  years { tax_year: 2025 note: "Page 1, Additional Exemptions: children born this tax year, $2,320 each." }
}

concepts {
  concept: "stillborn_child_exemption"
  years { tax_year: 2025 note: "Page 1, Additional Exemptions: a stillborn child, $2,320 each." }
}

