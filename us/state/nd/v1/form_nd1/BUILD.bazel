# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form ND-1: the return a full-year North Dakota resident files.
proto_library(
    name = "form_nd1_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_nd1.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/nd/v1/form_nd1.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/nd/v1/form_nd1:__pkg__"],
)
