# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form IA 1040 calls each concept, per tax year.
#
# Lines come from the 2025 Form IA 1040 as the Iowa Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# Steps 2 and 3 print their own short numbering (filing status boxes 1 to 5,
# exemption lines a to d), so a few numbers are shared with Step 4 onward; each
# concept on a shared number says which figure it is. Line 31b, previous
# refunds, is for amended returns and is not modelled.

form: "IA 1040"
message_name: "nexteggapp.taxprotos.us.state.ia.v1.FormIA1040"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "1" note: "Step 2: single, married filing jointly, married filing separately, head of household, qualifying surviving spouse; the boxes are numbered 1 to 5." }
}
concepts {
  concept: "claimed_as_dependent"
  years { tax_year: 2025 irs_box: "1" note: "Step 2, the Yes/No question beside status 1, Single." }
}
concepts {
  concept: "spouse_iowa_taxable_income"
  years { tax_year: 2025 irs_box: "3" note: "Step 2, beside status 3, Married filing separately; not Step 4 line 3." }
}
concepts {
  concept: "personal_credit"
  years { tax_year: 2025 irs_box: "a" note: "Step 3, line a: $40 each." }
}
concepts {
  concept: "age_65_or_blind_credit"
  years { tax_year: 2025 irs_box: "b" note: "Step 3, line b: $20 each." }
}
concepts {
  concept: "dependent_credit"
  years { tax_year: 2025 irs_box: "c" note: "Step 3, line c: $40 each." }
}
concepts {
  concept: "total_exemption_credit"
  years { tax_year: 2025 irs_box: "8" note: "Step 3 line d, carried to Step 5 line 8." }
}
concepts {
  concept: "federal_total_income"
  years { tax_year: 2025 irs_box: "1a" note: "Federal Form 1040 line 9." }
}
