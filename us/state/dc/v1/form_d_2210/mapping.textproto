# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for D-2210.
#
# Lines come from the 2025 form in testdata/, which is pdftotext -layout over
# the PDF the District of Columbia Office of Tax and
# Revenue publishes. The coverage test checks every
# line named here against that extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a return is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.
#
# Items A and B are lettered conditions on the form's front. The columns of
# lines 7 to 11 are mapped in mapping_periods.textproto.

form: "D-2210"
message_name: "nexteggapp.taxprotos.us.state.dc.v1.FormD2210"
tax_years: 2025

concepts {
  concept: "tax_under_threshold"
  years { tax_year: 2025 irs_box: "A." }
}

concepts {
  concept: "payments_met_requirement"
  years { tax_year: 2025 irs_box: "B." }
}

concepts {
  concept: "current_year_tax"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "prior_year_tax"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "prior_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "5" }
}

concepts {
  concept: "periodic_payment"
  years { tax_year: 2025 irs_box: "6" }
}

concepts {
  concept: "estimated_tax_penalty"
  years { tax_year: 2025 irs_box: "12" }
}
