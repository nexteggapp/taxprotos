# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form D-40 calls each concept, per tax year.
#
# Lines come from the 2025 Form D-40 as the District of Columbia Office of Tax
# and Revenue publishes it in the 2025 D-40 booklet. There are no amount codes:
# IRS Publication 1220 covers the information returns the IRS receives
# electronically, and a state return is not one of them.
#
# The income information above line 4 is printed as unnumbered lines a to d.

form: "D-40"
message_name: "nexteggapp.taxprotos.us.state.dc.v1.FormD40"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Line 1: single, married filing jointly, married filing separately, dependent claimed by someone else, head of household, qualifying widow(er)."
  }
}
concepts {
