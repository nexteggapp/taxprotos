# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form D-40: the return a full-year District of Columbia resident files.
proto_library(
    name = "form_d40_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_d40.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/dc/v1/form_d40.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/dc/v1/form_d40:__pkg__"],
)
