# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 40 calls each concept, per tax year.
#
# Lines come from the 2025 Form 40 as the Alabama Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# Page 2 numbers its parts from 1 again; the dependent count is page 2,
# Part III, line 1, and carries a note saying so.

form: "40"
message_name: "nexteggapp.taxprotos.us.state.al.v1.FormAL40"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "1" note: "Lines 1 to 4: single, married filing joint, married filing separate, head of family." }
}
concepts {
  concept: "itemizes"
  years { tax_year: 2025 irs_box: "11" note: "Box 11a checked." }
}
concepts {
  concept: "dependents"
  years { tax_year: 2025 irs_box: "1" note: "Page 2, Part III, line 1: number of dependents." }
}
