# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form R-210R: the penalty for underpayment of individual income tax a
# Louisiana resident attaches to Form IT-540.
proto_library(
    name = "form_r_210r_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_r_210r.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mappings and the form extract they are checked against, for
# //go/us/state/la/v1/form_r_210r.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping*.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/la/v1/form_r_210r:__pkg__"],
)
