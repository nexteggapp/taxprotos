# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for Form R-210R.
#
# Lines come from the 2025 form (R-210R (1/26)) in testdata/, which is
# pdftotext -layout over the PDF the Louisiana Department of Revenue
# publishes. The coverage test checks every line named here against that
# extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.
#
# Line 4 is a count and line 10 a box, so neither is an amount; the columns
# of Sections 2 to 4 are mapped in mapping_period.textproto.

form: "R-210R"
message_name: "nexteggapp.taxprotos.us.state.la.v1.FormR210r"
tax_years: 2025

concepts {
  concept: "current_year_tax_liability"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "prior_year_tax_liability"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "payments_required"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "below_threshold_exception"
  years { tax_year: 2025 irs_box: "10" }
}

concepts {
  concept: "underpayment_penalty"
  years { tax_year: 2025 irs_box: "19" }
}
