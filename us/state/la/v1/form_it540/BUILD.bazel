# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form IT-540: the return a full-year Louisiana resident files.
proto_library(
    name = "form_it540_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_it540.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/la/v1/form_it540.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/la/v1/form_it540:__pkg__"],
)
