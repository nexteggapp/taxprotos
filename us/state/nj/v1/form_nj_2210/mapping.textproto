# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form NJ-2210 calls each concept, per tax year.
#
# Lines come from the 2025 Form NJ-2210 as the New Jersey Division of
# Taxation publishes it, in testdata/. There are no amount codes: IRS
# Publication 1220 covers the information returns the IRS receives
# electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. The columns of lines 5 to 18, the worksheets and the
# interest table are messages whose fields name their lines in their
# comments.

form: "NJ-2210"
message_name: "nexteggapp.taxprotos.us.state.nj.v1.FormNj2210"
tax_years: 2025

concepts {
  concept: "tax"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "withholding_and_credits"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "tax_less_withholding_and_credits"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "4a" }
}

concepts {
  concept: "prior_year_tax"
  years { tax_year: 2025 irs_box: "4b" }
}

concepts {
  concept: "payment_periods"
  years {
    tax_year: 2025
    irs_box: "5"
    note: "Lines 5 to 18, one entry per column; each entry's fields name their own lines."
  }
}

concepts {
  concept: "total_interest"
  years { tax_year: 2025 irs_box: "19" }
}

concepts {
  concept: "prior_year_income_worksheet"
  years {
    tax_year: 2025
    irs_box: "II"
    note: "The Exception II worksheet on page 2, lines 1 to 6; its fields name their own lines."
  }
}

concepts {
  concept: "annualization_periods"
  years {
    tax_year: 2025
    irs_box: "III"
    note: "The Exception III worksheet on page 2, lines 1 to 8, one entry per column."
  }
}

concepts {
  concept: "income_to_date_periods"
  years {
    tax_year: 2025
    irs_box: "IV"
    note: "The Exception IV worksheet on page 2, lines 1 to 4, one entry per column."
  }
}

concepts {
  concept: "interest_quarters"
  years {
    tax_year: 2025
    irs_box: "OPTION 1"
    note: "Calculating the Interest: Option 1's table, columns A to G, one entry per quarter, with Option 2's computations."
  }
}
