# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form NJ-1040 calls each concept, per tax year.
#
# Lines come from the 2025 Form NJ-1040 as the New Jersey Division of Taxation
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# The form prints line 37 as "37a" with "b" and "c" set beside it, so 37b and
# 37c never appear as such. They are mapped to line 37a with a note saying
# which part they are.

form: "NJ-1040"
message_name: "nexteggapp.taxprotos.us.state.nj.v1.FormNJ1040"
tax_years: 2025

concepts {
