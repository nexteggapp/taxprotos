# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form 80-105: the return a full-year Mississippi resident files.
proto_library(
    name = "form_80105_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_80105.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ms/v1/form_80105.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ms/v1/form_80105:__pkg__"],
)
