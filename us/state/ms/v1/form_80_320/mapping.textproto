# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 80-320 calls each concept, per tax year.
#
# Lines come from Form 80-320 (Rev. 09/25), for 2025, as the Mississippi
# Department of Revenue publishes it, in testdata/. There are no amount
# codes: IRS Publication 1220 covers the information returns the IRS
# receives electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. The columns of lines 5 to 10 are repeated messages
# whose fields name their lines in their comments.

form: "80-320"
message_name: "nexteggapp.taxprotos.us.state.ms.v1.Form80320"
tax_years: 2025

concepts {
  concept: "liability"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "prior_year_liability"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "payment_periods"
  years {
    tax_year: 2025
    irs_box: "5"
    note: "Lines 5 to 10, one entry per column; each entry's fields name their own lines."
  }
}

concepts {
  concept: "total_interest"
  years { tax_year: 2025 irs_box: "11" }
}

concepts {
  concept: "first_time_home_buyer_penalty"
  years { tax_year: 2025 irs_box: "12" }
}

concepts {
  concept: "late_filing_balance_due"
  years { tax_year: 2025 irs_box: "13" }
}

concepts {
  concept: "late_filing_penalty"
  years { tax_year: 2025 irs_box: "14" }
}

concepts {
  concept: "late_payment_balance_due"
  years { tax_year: 2025 irs_box: "15" }
}

concepts {
  concept: "late_payment_interest"
  years { tax_year: 2025 irs_box: "16" }
}

concepts {
  concept: "late_payment_penalty"
  years { tax_year: 2025 irs_box: "17" }
}

concepts {
  concept: "total_late_payment_interest_and_penalty"
  years { tax_year: 2025 irs_box: "18" }
}

concepts {
  concept: "total_interest_and_penalty"
  years { tax_year: 2025 irs_box: "19" }
}
