}
concepts {
  concept: "deduction"
  years { tax_year: 2025 irs_box: "11" note: "The amount." }
}
concepts {
  concept: "itemized"
  years { tax_year: 2025 irs_box: "11" note: "Which of the two circles is filled in." }
}
