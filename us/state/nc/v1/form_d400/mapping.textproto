# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form D-400 calls each concept, per tax year.
#
# Lines come from the 2025 Form D-400 as the North Carolina Department of
# Revenue publishes it. There are no amount codes: IRS Publication 1220 covers
# the information returns the IRS receives electronically, and a state return is
# not one of them.
#
# The form prints its line numbers with a trailing full stop, as Oregon's does,
# and prints the parts of lines 20, 21 and 26 as "a." to "e." beside the number.
# A part that never appears as, say, "21c" is mapped to its line with a note
# saying which part it is.

form: "D-400"
message_name: "nexteggapp.taxprotos.us.state.nc.v1.FormD400"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Circles 1 to 5: single, married filing jointly, married filing separately, head of household, qualifying widow(er)."
  }
}
concepts {
  concept: "federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "6" note: "Federal Form 1040 line 11a." }
}
concepts {
  concept: "total_additions"
  years { tax_year: 2025 irs_box: "7" note: "From Schedule S, Part A, line 16." }
}
