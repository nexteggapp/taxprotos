# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form N-11: the return a full-year Hawaii resident files.
proto_library(
    name = "form_n11_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_n11.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/hi/v1/form_n11.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/hi/v1/form_n11:__pkg__"],
)
