# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form N-210 calls each concept, per tax year.
#
# Lines come from Form N-210 (Rev. 2025) as the Hawaii Department of
# Taxation publishes it, in testdata/, which is pdftotext -layout over the
# PDF. The coverage test beside the Go package checks every line named here
# against that extract. The columns of Parts III and IV and of Schedule A are
# repeated messages, whose lines their fields' comments name.
#
# There are no amount codes: IRS Publication 1220 covers the information
# returns the IRS receives electronically, and a state form is not one of
# them.

form: "N-210"
message_name: "nexteggapp.taxprotos.us.state.hi.v1.FormN210"
tax_years: 2025

concepts {
  concept: "no_liability_last_year"
  years {
    tax_year: 2025
    irs_box: "A"
    note: "Part I"
  }
}

