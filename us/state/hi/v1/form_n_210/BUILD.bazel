# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form N-210: the penalty for underpaying Hawaii estimated tax.
proto_library(
    name = "form_n_210_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_n_210.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/hi/v1/form_n_210.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/hi/v1/form_n_210:__pkg__"],
)
