# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form MO-2210 calls each concept, per tax year.
#
# Lines come from the 2025 Form MO-2210 as the Missouri Department of
# Revenue publishes it, in testdata/. There are no amount codes: IRS
# Publication 1220 covers the information returns the IRS receives
# electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. The columns of lines 15 to 28c are repeated messages
# whose fields name their lines in their comments.

form: "MO-2210"
message_name: "nexteggapp.taxprotos.us.state.mo.v1.FormMo2210"
tax_years: 2025

concepts {
  concept: "farmer_exempt"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Line 1, \"Exempt, farmer\", written in place of the tax (instruction J)."
  }
}

concepts {
  concept: "tax_after_credits"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Line 1, the tax after credits."
  }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "tax_withheld"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "tax_less_withholding"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "prior_year_tax"
  years { tax_year: 2025 irs_box: "5" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "6" }
}

concepts {
  concept: "short_method_withholding"
  years { tax_year: 2025 irs_box: "7" }
}

concepts {
  concept: "short_method_estimated_tax_payments"
  years { tax_year: 2025 irs_box: "8" }
}

concepts {
  concept: "short_method_total_payments"
  years { tax_year: 2025 irs_box: "9" }
}

concepts {
  concept: "short_method_underpayment"
  years { tax_year: 2025 irs_box: "10" }
}

concepts {
  concept: "short_method_full_penalty"
  years { tax_year: 2025 irs_box: "11" }
}

concepts {
  concept: "short_method_early_payment_reduction"
  years { tax_year: 2025 irs_box: "12" }
}

concepts {
  concept: "short_method_penalty"
  years { tax_year: 2025 irs_box: "13" }
}

concepts {
  concept: "regular_method_required_annual_payment"
  years { tax_year: 2025 irs_box: "14" }
}

concepts {
  concept: "payment_periods"
  years {
    tax_year: 2025
    irs_box: "15"
    note: "Lines 15 to 28c, one entry per column; each entry's fields name their own lines."
  }
}

concepts {
  concept: "total_penalty"
  years { tax_year: 2025 irs_box: "29" }
}
