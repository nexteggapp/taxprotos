# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form MI-2210: the underpayment of estimated income tax form a Michigan filer
# includes with Form MI-1040 or MI-1041.
proto_library(
    name = "form_mi_2210_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_mi_2210.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mappings and the form extract they are checked against, for
# //go/us/state/mi/v1/form_mi_2210.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping*.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/mi/v1/form_mi_2210:__pkg__"],
)
