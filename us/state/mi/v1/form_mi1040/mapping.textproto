# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form MI-1040 calls each concept, per tax year.
#
# Lines come from the 2025 Form MI-1040 as the Michigan Department of Treasury
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# Line 9 prints a count and an amount on each of lines 9a to 9d, both under the
# same number; the count and the amount are mapped to it with a note saying
# which is which. Line 33 is for amended returns only and is not modelled.

form: "MI-1040"
message_name: "nexteggapp.taxprotos.us.state.mi.v1.FormMI1040"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "7" note: "Item 7: single, married filing jointly, married filing separately." }
}
concepts {
  concept: "claimed_as_dependent"
  years { tax_year: 2025 irs_box: "9e" note: "The box on line 9e." }
}
concepts {
  concept: "exemptions"
  years { tax_year: 2025 irs_box: "9a" note: "The number of exemptions." }
}
concepts {
  concept: "personal_exemption"
  years { tax_year: 2025 irs_box: "9a" note: "The amount: the number times the exemption allowance." }
}
concepts {
  concept: "special_exemptions"
  years { tax_year: 2025 irs_box: "9b" note: "The number of individuals." }
}
concepts {
  concept: "special_exemption"
  years { tax_year: 2025 irs_box: "9b" note: "The amount." }
}
