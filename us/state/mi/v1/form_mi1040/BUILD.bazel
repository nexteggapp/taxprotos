# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form MI-1040: the return a full-year Michigan resident files.
proto_library(
    name = "form_mi1040_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_mi1040.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/mi/v1/form_mi1040.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/mi/v1/form_mi1040:__pkg__"],
)
