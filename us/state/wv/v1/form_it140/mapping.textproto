# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form IT-140 calls each concept, per tax year.
#
# Lines come from the 2025 Form IT-140 as the West Virginia Tax Division
# publishes it. Lines 29 and above are on Schedule M, which is part of the
# form. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is
# not one of them.

form: "IT-140"
message_name: "nexteggapp.taxprotos.us.state.wv.v1.FormIT140"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    irs_box: "FILING STATUS"
    note: "Boxes 1 to 5: single, head of household, married filing joint, married filing separate, widow(er) with dependent child."
  }
}
