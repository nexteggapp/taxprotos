# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for Worksheet IN-152.
#
# Lines come from the 2025 form in testdata/, which is pdftotext -layout over
# the PDF the Vermont Department of Taxes publishes. The coverage test checks
# every line named here against that extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a return is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.

form: "IN-152"
message_name: "nexteggapp.taxprotos.us.state.vt.v1.FormIn152"
tax_years: 2025

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "1." }
}

concepts {
  concept: "prior_year_tax"
  years { tax_year: 2025 irs_box: "2." }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "3." }
}

concepts {
  concept: "total_required_installments"
  years { tax_year: 2025 irs_box: "4." note: "The Totals column of line 4." }
}

concepts {
  concept: "total_underpayment"
  years { tax_year: 2025 irs_box: "6." note: "The Totals column of line 6." }
}

concepts {
  concept: "total_interest"
  years { tax_year: 2025 irs_box: "11." }
}

concepts {
  concept: "total_penalty"
  years { tax_year: 2025 irs_box: "14." }
}

concepts {
  concept: "total_interest_and_penalty"
  years { tax_year: 2025 irs_box: "15." }
}
