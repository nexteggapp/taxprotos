# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form PA-40 calls each concept, per tax year.
#
# Lines come from the 2025 Form PA-40 as the Pennsylvania Department of
# Revenue publishes it. There are no amount codes: IRS Publication 1220 covers
# the information returns the IRS receives electronically, and a state return
# is not one of them.
#
# The five refund donation lines, 32 to 36, are one figure here, mapped to
# line 32 with a note.

form: "PA-40"
message_name: "nexteggapp.taxprotos.us.state.pa.v1.FormPA40"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "S" note: "Filing Status ovals: S single, J married filing jointly, M married filing separately." }
}
