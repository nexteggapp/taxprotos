# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form REV-1630: underpayment of estimated tax by individuals.
proto_library(
    name = "form_rev_1630_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_rev_1630.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/pa/v1/form_rev_1630.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/pa/v1/form_rev_1630:__pkg__"],
)
