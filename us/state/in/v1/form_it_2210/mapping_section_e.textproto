# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for one column of Schedule
# IT-2210 Section E, Regular Method.
#
# Lines come from the 2025 schedule (R27 / 9-25) in testdata/, which is
# pdftotext -layout over the PDF the Indiana Department of Revenue
# publishes. The coverage test checks every line named here against that
# extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a state schedule is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.

form: "IT-2210"
message_name: "nexteggapp.taxprotos.us.state.in.v1.FormIt2210.InstallmentPeriod"
tax_years: 2025

concepts {
  concept: "required_installment"
  years { tax_year: 2025 irs_box: "14" }
}

concepts {
  concept: "withholding_and_ptet"
  years { tax_year: 2025 irs_box: "15" }
}

concepts {
  concept: "estimated_tax_paid"
  years { tax_year: 2025 irs_box: "16" }
}

concepts {
  concept: "total_installment_payments"
  years { tax_year: 2025 irs_box: "17" }
}

concepts {
  concept: "overpayment"
  years { tax_year: 2025 irs_box: "18" }
}

concepts {
  concept: "underpayment"
  years { tax_year: 2025 irs_box: "19" }
}
