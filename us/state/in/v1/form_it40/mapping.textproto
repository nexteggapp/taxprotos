# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form IT-40 calls each concept, per tax year.
#
# Lines come from the 2025 Form IT-40 as the Indiana Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# Line 22 is direct deposit and carries no amount. The county codes and the
# married filing separately box are printed above line 1 without a line number.

form: "IT-40"
message_name: "nexteggapp.taxprotos.us.state.in.v1.FormIT40"
tax_years: 2025

concepts {
  concept: "federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "1" }
}
