# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Schedule IT-2210A: the annualized penalty for underpayment of estimated tax
# an Indiana filer encloses with Form IT-40 or IT-40PNR.
proto_library(
    name = "form_it_2210a_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_it_2210a.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mappings and the form extract they are checked against, for
# //go/us/state/in/v1/form_it_2210a.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping*.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/in/v1/form_it_2210a:__pkg__"],
)
