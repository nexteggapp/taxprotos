# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for one column of Schedule IT-2210A
# Section 3, lines 1 to 25: the annualized tax, the installment it sets,
# and the payments applied to it.
#
# Lines come from the 2025 schedule (R25 / 9-25) in testdata/, which is
# pdftotext -layout over the PDF the Indiana Department of Revenue
# publishes. The coverage test checks every line named here against that
# extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a state schedule is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.
#
# Line 12 is carried to the second page as line 12a, the same figure.

form: "IT-2210A"
message_name: "nexteggapp.taxprotos.us.state.in.v1.FormIt2210a.Period"
tax_years: 2025

concepts {
  concept: "indiana_adjusted_income"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "annualized_income"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "exemptions"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "annualized_taxable_income"
  years { tax_year: 2025 irs_box: "5" }
}

