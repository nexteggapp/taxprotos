# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form 502: the return a full-year Maryland resident files.
proto_library(
    name = "form_502_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_502.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/md/v1/form_502.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/md/v1/form_502:__pkg__"],
)
