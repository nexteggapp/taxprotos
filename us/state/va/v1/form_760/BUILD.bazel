# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form 760: the return a full-year Virginia resident files.
proto_library(
    name = "form_760_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_760.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/va/v1/form_760.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/va/v1/form_760:__pkg__"],
)
