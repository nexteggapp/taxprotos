# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 760C calls each concept, per tax year.
#
# Lines come from the 2025 Form 760C (Rev. 04/26) as the Virginia Department
# of Taxation publishes it, in testdata/. There are no amount codes: IRS
# Publication 1220 covers the information returns the IRS receives
# electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. The columns of lines 6 to 24 are repeated messages
# whose fields name their lines in their comments.

form: "760C"
message_name: "nexteggapp.taxprotos.us.state.va.v1.Form760c"
tax_years: 2025

concepts {
  concept: "tax_liability"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "ninety_percent_of_tax"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "prior_year_tax_liability"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "installments_required"
  years { tax_year: 2025 irs_box: "5" }
}

concepts {
  concept: "installment_periods"
  years {
    tax_year: 2025
    irs_box: "6"
    note: "Lines 6 to 24, one entry per column; each entry's fields name their own lines."
  }
}

concepts {
  concept: "small_underpayment"
  years {
    tax_year: 2025
    irs_box: "14"
    note: "Line 14's stop: the year's underpayments total the small amount or less."
  }
}

concepts {
  concept: "addition_to_tax"
  years { tax_year: 2025 irs_box: "25" }
}
