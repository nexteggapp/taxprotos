# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form TC-40 calls each concept, per tax year.
#
# Lines come from the 2025 Form TC-40 as the Utah State Tax Commission
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# The form prints the parts of box 2 as a bare "a" to "d" beside the number, so
# 2a to 2d never appear as such. They are mapped to line 2 with a note saying
# which part they are.

form: "TC-40"
message_name: "nexteggapp.taxprotos.us.state.ut.v1.FormTC40"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "1" note: "Line 1: the filing status code, 1 to 5." }
}
concepts {
  concept: "dependents_age_16_and_under"
  years { tax_year: 2025 irs_box: "2" note: "Box 2, line a." }
}
concepts {
  concept: "other_dependents"
  years { tax_year: 2025 irs_box: "2" note: "Box 2, line b." }
}
