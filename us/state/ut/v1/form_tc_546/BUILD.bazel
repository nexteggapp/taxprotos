# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form TC-546: the Payment Worksheet, Utah's prepayment test for an extended return.
proto_library(
    name = "form_tc_546_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_tc_546.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ut/v1/form_tc_546.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ut/v1/form_tc_546:__pkg__"],
)
