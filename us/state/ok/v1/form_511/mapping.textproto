}
concepts {
  concept: "adjustments"
  years { tax_year: 2025 irs_box: "8" }
}
concepts {
  concept: "income_after_adjustments"
  years { tax_year: 2025 irs_box: "9" }
}
concepts {
  concept: "deduction"
  years { tax_year: 2025 irs_box: "10" }
}
concepts {
  concept: "exemption_amount"
  years {
    tax_year: 2025
    irs_box: "11"
    note: "The dollar amount: the number of exemptions times $1,000."
  }
}
concepts {
  concept: "total_deductions_and_exemptions"
  years { tax_year: 2025 irs_box: "12" }
}
concepts {
  concept: "taxable_income"
  years { tax_year: 2025 irs_box: "13" }
}
concepts {
  concept: "tax"
  years {
    tax_year: 2025
    irs_box: "14"
    note: "Line 14(a): tax from the tax table or Form 573."
