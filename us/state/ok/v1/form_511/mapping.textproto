# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 511 calls each concept, per tax year.
#
# Lines come from the 2025 Form 511 as the Oklahoma Tax Commission publishes
# it. There are no amount codes: IRS Publication 1220 covers the information
# returns the IRS receives electronically, and a state return is not one of
# them.
#
# Line 1 is shared by the filing status (boxes 1 to 5 at the top of page 1)
# and federal adjusted gross income, and line 11 by the exemption count and
# its dollar amount; lines 14 and 41 each have parts (a) and (b).

form: "511"
message_name: "nexteggapp.taxprotos.us.state.ok.v1.Form511"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Boxes 1 to 5: single, married filing joint, married filing separate, head of household, qualifying surviving spouse."
  }
}
concepts {
  concept: "total_exemptions"
  years {
    tax_year: 2025
    irs_box: "11"
    note: "The count of exemptions from page 1 that line 11 multiplies by $1,000."
  }
}
concepts {
  concept: "federal_adjusted_gross_income"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Line 1: federal adjusted gross income from Form 1040."
  }
}
concepts {
  concept: "subtractions"
  years { tax_year: 2025 irs_box: "2" }
}
concepts {
  concept: "income_after_subtractions"
  years { tax_year: 2025 irs_box: "3" }
}
