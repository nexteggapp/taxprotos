# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form 511: the return a full-year Oklahoma resident files.
proto_library(
    name = "form_511_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_511.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ok/v1/form_511.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ok/v1/form_511:__pkg__"],
)
