# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form CT-2210 calls each concept, per tax year.
#
# Lines come from the 2025 Form CT-2210 (Rev. 12/25) as the Connecticut
# Department of Revenue Services publishes it, in testdata/. There are no
# amount codes: IRS Publication 1220 covers the information returns the IRS
# receives electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. Part 3's columns, Schedule A's columns and Schedule
# B's months are repeated messages whose fields name their lines in their
# comments.

form: "CT-2210"
message_name: "nexteggapp.taxprotos.us.state.ct.v1.FormCt2210"
tax_years: 2025

concepts {
  concept: "annualized_income_method"
