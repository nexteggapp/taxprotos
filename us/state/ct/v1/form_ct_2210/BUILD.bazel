# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form CT-2210: underpayment of estimated tax.
proto_library(
    name = "form_ct_2210_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_ct_2210.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ct/v1/form_ct_2210.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ct/v1/form_ct_2210:__pkg__"],
)
