# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form RI-1040 calls each concept, per tax year.
#
# Lines come from the 2025 RI-1040 instructions as the Rhode Island Division of
# Taxation publishes them; testdata/SOURCES.md says why the instructions rather
# than the form. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is
# not one of them.
#
# Line 13b repeats line 13a and has no concept of its own. Line 6 holds both
# the number of exemptions and their amount.

form: "RI-1040"
message_name: "nexteggapp.taxprotos.us.state.ri.v1.FormRI1040"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    irs_box: "FILING STATUS"
    note: "Single, married joint, married separate, head of household, qualifying widow(er)."
  }
}
concepts {
  concept: "federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "1" note: "Federal Form 1040 line 11a." }
}
concepts {
  concept: "net_modifications"
  years { tax_year: 2025 irs_box: "2" note: "RI Schedule M page 2 line 3." }
}
concepts {
  concept: "modified_federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "3" }
}
concepts {
  concept: "standard_deduction"
  years { tax_year: 2025 irs_box: "4" }
}
concepts {
  concept: "income_after_deduction"
  years { tax_year: 2025 irs_box: "5" }
}
concepts {
  concept: "exemptions"
  years { tax_year: 2025 irs_box: "6" note: "The number in the box on line 6, from RI Schedule E line 5." }
}
concepts {
  concept: "exemption_amount"
  years { tax_year: 2025 irs_box: "6" note: "The amount: the number of exemptions times $5,100." }
}
concepts {
  concept: "taxable_income"
  years { tax_year: 2025 irs_box: "7" }
}
concepts {
