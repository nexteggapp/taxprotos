  concept: "total_exemptions"
  years { tax_year: 2025 irs_box: "10c" note: "Lines 10a plus 10b." }
}
concepts {
  concept: "taxable_income"
  years { tax_year: 2025 irs_box: "11" note: "Line 9 less line 10c, not below zero." }
}
concepts {
  concept: "tax"
  years { tax_year: 2025 irs_box: "12" note: "From the tax table or the tax computation worksheet." }
}
