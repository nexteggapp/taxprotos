# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Wisconsin Form 1 calls each concept, per tax year.
#
# Lines come from the 2025 Form 1 as the Wisconsin Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.

form: "1"
message_name: "nexteggapp.taxprotos.us.state.wi.v1.Form1"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 note: "The filing status boxes on page 1 carry no line number." }
}
concepts {
  concept: "exemption_count"
  years { tax_year: 2025 irs_box: "10a" note: "The number of exemptions, beside the amount." }
}
concepts {
  concept: "age_65_count"
  years { tax_year: 2025 irs_box: "10b" note: "The number of boxes checked, beside the amount." }
}
concepts {
  concept: "federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "1" note: "Federal adjusted gross income, Form 1040 line 11." }
}
concepts {
  concept: "schedule_i_adjustments"
  years { tax_year: 2025 irs_box: "2" note: "Adjustments from Schedule I, line 3." }
}
concepts {
  concept: "wisconsin_federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "3" note: "Federal AGI for Wisconsin purposes: lines 1 plus 2." }
}
concepts {
  concept: "additions"
  years { tax_year: 2025 irs_box: "4" note: "Total additions from Schedule AD, line 33." }
}
concepts {
  concept: "income_before_subtractions"
  years { tax_year: 2025 irs_box: "5" note: "Lines 3 plus 4." }
}
concepts {
  concept: "subtractions"
  years { tax_year: 2025 irs_box: "6" note: "Total subtractions from Schedule SB, line 50." }
}
concepts {
  concept: "wisconsin_income"
  years { tax_year: 2025 irs_box: "7" note: "Wisconsin income: line 5 less line 6." }
}
concepts {
  concept: "standard_deduction"
  years { tax_year: 2025 irs_box: "8" note: "The sliding-scale standard deduction." }
}
concepts {
  concept: "income_after_standard_deduction"
  years { tax_year: 2025 irs_box: "9" note: "Line 7 less line 8, not below zero." }
}
concepts {
  concept: "personal_exemptions"
  years { tax_year: 2025 irs_box: "10a" note: "$700 for each exemption." }
}
concepts {
  concept: "age_65_exemptions"
  years { tax_year: 2025 irs_box: "10b" note: "$250 for each filer 65 or older." }
}
