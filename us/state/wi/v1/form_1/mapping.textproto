  years { tax_year: 2025 irs_box: "13" note: "From Schedule 1." }
}
concepts {
  concept: "child_and_dependent_care_credit"
  years { tax_year: 2025 irs_box: "14" note: "Additional child and dependent care tax credit, Schedule WI-2441." }
}
