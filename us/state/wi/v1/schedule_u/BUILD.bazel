# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Schedule U: underpayment of Wisconsin estimated tax.
proto_library(
    name = "schedule_u_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "schedule_u.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mappings and the form extract they are checked against, for
# //go/us/state/wi/v1/schedule_u.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping*.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/wi/v1/schedule_u:__pkg__"],
)
