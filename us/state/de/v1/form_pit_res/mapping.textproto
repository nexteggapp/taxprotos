# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form PIT-RES calls each concept, per tax year.
#
# Lines come from the 2025 Form PIT-RES as the Delaware Division of Revenue
# publishes it, Column B. There are no amount codes: IRS Publication 1220
# covers the information returns the IRS receives electronically, and a state
# return is not one of them.

form: "PIT-RES"
message_name: "nexteggapp.taxprotos.us.state.de.v1.FormPITRES"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    note: "Unnumbered filing status boxes 1 to 5 at the top of page 1."
  }
}
concepts {
  concept: "claimed_as_dependent"
  years {
    tax_year: 2025
    note: "Unnumbered box at the top of page 1: claimed as a dependent on someone else's return."
  }
}
