# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for FTB 5805.
#
# Lines come from the 2025 form in testdata/, which is pdftotext -layout over
# the PDF the Franchise Tax Board publishes. The coverage test checks every
# line named here against that extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a return is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.
#
# Part I numbers its questions from 1 and Part II its lines from 1, so every
# concept carries a note saying which part it is in. The columns of Part III
# are mapped in mapping_part_iii.textproto. Worksheets I and II are printed in
# the instructions, not on the form; the schema's comments name their lines.

form: "FTB 5805"
message_name: "nexteggapp.taxprotos.us.state.ca.v1.FormFtb5805"
tax_years: 2025

concepts {
  concept: "requests_waiver"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Part I, Question 1: the Yes box."
  }
}

concepts {
  concept: "waiver_explanation"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Part I, Question 1: the explanation below the question."
  }
}

concepts {
  concept: "uses_annualized_income_method"
  years {
    tax_year: 2025
    irs_box: "2"
    note: "Part I, Question 2."
  }
}

concepts {
  concept: "shows_actual_withholding"
  years {
    tax_year: 2025
    irs_box: "3"
    note: "Part I, Question 3: the Yes box."
  }
}

concepts {
  concept: "actual_withholding"
  years {
    tax_year: 2025
    irs_box: "3"
    note: "Part I, Question 3: the four amounts withheld, by due date."
  }
}

concepts {
  concept: "within_two_years_of_death"
  years {
    tax_year: 2025
    irs_box: "4"
    note: "Part I, Question 4."
  }
}

concepts {
  concept: "current_year_tax"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Part II: current year tax."
  }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years {
    tax_year: 2025
    irs_box: "2"
    note: "Part II: line 1 multiplied by 90%."
  }
}

concepts {
  concept: "total_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "3"
    note: "Part II: withholding taxes."
  }
}

concepts {
  concept: "net_tax_after_withholding"
  years {
    tax_year: 2025
    irs_box: "4"
    note: "Part II: line 1 minus line 3."
  }
}

concepts {
  concept: "prior_year_safe_harbor_tax"
  years {
    tax_year: 2025
    irs_box: "5"
    note: "Part II: the prior year's tax, or 110% of it."
  }
}

concepts {
  concept: "required_annual_payment"
  years {
    tax_year: 2025
    irs_box: "6"
    note: "Part II: required annual payment."
  }
}

concepts {
  concept: "short_method_withholding"
  years {
    tax_year: 2025
    irs_box: "7"
    note: "Part II, Short Method."
  }
}

concepts {
  concept: "short_method_estimated_payments"
  years {
    tax_year: 2025
    irs_box: "8"
    note: "Part II, Short Method."
  }
}

concepts {
  concept: "short_method_total_payments"
  years {
    tax_year: 2025
    irs_box: "9"
    note: "Part II, Short Method."
  }
}

concepts {
