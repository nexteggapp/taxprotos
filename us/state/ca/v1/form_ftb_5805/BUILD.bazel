# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form FTB 5805: the underpayment of estimated tax form a California filer
# attaches to Form 540, Form 540NR or Form 541.
proto_library(
    name = "form_ftb_5805_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_ftb_5805.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mappings and the form extract they are checked against, for
# //go/us/state/ca/v1/form_ftb_5805.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping*.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ca/v1/form_ftb_5805:__pkg__"],
)
