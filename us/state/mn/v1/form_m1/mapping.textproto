# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form M1 calls each concept, per tax year.
#
# Lines come from the 2025 Form M1 as the Minnesota Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# Items A to F, copied from the federal return, are lettered rather than
# numbered.

form: "M1"
message_name: "nexteggapp.taxprotos.us.state.mn.v1.FormM1"
tax_years: 2025

concepts {
  concept: "itemized"
  years {
    tax_year: 2025
    irs_box: "4"
    note: "Whether line 4 is itemized deductions rather than the standard deduction."
  }
}
concepts {
  concept: "wages"
  years { tax_year: 2025 irs_box: "A" }
}
concepts {
  concept: "ira_pensions_and_annuities"
