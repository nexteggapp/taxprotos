# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form PIT-1 calls each concept, per tax year.
#
# Lines come from the 2025 Form PIT-1 as the New Mexico Taxation and Revenue
# Department publishes it. There are no amount codes: IRS Publication 1220
# covers the information returns the IRS receives electronically, and a state
# return is not one of them.
#
# Line 23 repeats line 22 at the top of page 2 and has no field of its own.

form: "PIT-1"
message_name: "nexteggapp.taxprotos.us.state.nm.v1.FormPIT1"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "7" }
}
concepts {
  concept: "exemptions"
  years { tax_year: 2025 irs_box: "5" }
}
concepts {
  concept: "itemized"
  years { tax_year: 2025 irs_box: "12a" }
}
concepts {
  concept: "federal_adjusted_gross_income"
  years { tax_year: 2025 irs_box: "9" note: "Federal Form 1040 line 11." }
}
concepts {
  concept: "state_and_local_tax_deduction"
  years { tax_year: 2025 irs_box: "10" note: "If itemized: the state and local tax deduction from federal Schedule A line 5a, added back." }
}
