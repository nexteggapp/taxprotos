# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 221 calls each concept, per tax year.
#
# Lines come from the 2025 Form 221 as the Arizona Department of Revenue
# publishes it, in testdata/. There are no amount codes: IRS Publication 1220
# covers the information returns the IRS receives electronically, and a state
# form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. The columns of lines 10 to 29 and of the worksheet are
# repeated messages whose fields name their lines in their comments.

form: "221"
message_name: "nexteggapp.taxprotos.us.state.az.v1.Form221"
tax_years: 2025

concepts {
  concept: "claims_federal_exception"
  years {
    tax_year: 2025
    irs_box: "1"
    note: "Part A. The box claiming federal relief under IRC § 6654."
  }
}

concepts {
  concept: "tax"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "tax_credits"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "tax_after_credits"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "arizona_tax_withheld"
  years { tax_year: 2025 irs_box: "5" }
}

concepts {
  concept: "tax_less_withholding"
  years { tax_year: 2025 irs_box: "6" }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "7" }
}

concepts {
  concept: "prior_year_tax_after_credits"
  years { tax_year: 2025 irs_box: "8" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "9" }
}

concepts {
  concept: "uses_other_installment_method"
  years {
    tax_year: 2025
    irs_box: "11"
    note: "The box on line 11, for an installment method other than four equal installments."
  }
}

concepts {
  concept: "payment_periods"
  years {
    tax_year: 2025
    irs_box: "10"
    note: "Lines 10 to 29, one entry per column (a) to (d); each entry's fields name their own lines."
  }
}

concepts {
  concept: "total_penalty"
  years {
    tax_year: 2025
    irs_box: "30"
    note: "Box 30a: line 29, columns (a) through (d), added."
  }
}

concepts {
  concept: "waiver_request"
  years {
    tax_year: 2025
    irs_box: "30"
    note: "Box 30b: the penalty for which a waiver is requested."
  }
}

concepts {
  concept: "penalty_after_waiver"
  years {
    tax_year: 2025
    irs_box: "30"
    note: "Box 30c: box 30a minus box 30b, rounded to the whole dollar."
  }
}

concepts {
  concept: "annualization_periods"
  years {
    tax_year: 2025
    irs_box: "23"
    note: "The Annualized Income Installment Worksheet on page 2, lines 1 to 23, one entry per column; each entry's fields name their own lines."
  }
}
