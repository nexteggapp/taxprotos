# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form M-2210: the penalty for underpayment of estimated income tax a
# Massachusetts filer encloses with Form 1 or 1-NR/PY.
proto_library(
    name = "form_m_2210_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_m_2210.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mappings and the form extract they are checked against, for
# //go/us/state/ma/v1/form_m_2210.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping*.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ma/v1/form_m_2210:__pkg__"],
)
