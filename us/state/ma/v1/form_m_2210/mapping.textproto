# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for Form M-2210.
#
# Lines come from the 2025 form in testdata/, which is pdftotext -layout over
# the PDF the Massachusetts Department of Revenue publishes. The coverage
# test checks every line named here against that extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.
#
# The columns of Parts 1 and 2 are mapped in mapping_installment.textproto,
# and those of Part 3 in mapping_period.textproto.

form: "M-2210"
message_name: "nexteggapp.taxprotos.us.state.ma.v1.FormM2210"
tax_years: 2025

concepts {
  concept: "total_tax"
  years { tax_year: 2025 irs_box: "1" }
}

concepts {
  concept: "credits"
  years { tax_year: 2025 irs_box: "2" }
}

concepts {
  concept: "tax_after_credits"
  years { tax_year: 2025 irs_box: "3" }
}

concepts {
  concept: "current_year_safe_harbor_tax"
  years { tax_year: 2025 irs_box: "4" }
}

concepts {
  concept: "prior_year_tax"
  years { tax_year: 2025 irs_box: "5" }
}

concepts {
  concept: "required_annual_payment"
  years { tax_year: 2025 irs_box: "6" }
}

concepts {
  concept: "penalty"
  years { tax_year: 2025 irs_box: "24" }
}
