# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Massachusetts Form 1 calls each concept, per tax year.
#
# Lines come from the 2025 Form 1 as the Massachusetts Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# The two federal figures at the top of page 1 are printed as items a and b.
# Lines 2e, 2g, 6a, 8a, 8b and 38b are printed with the dot leader running
# into the number (".2e"), so the extract never shows them standing alone.
# They are mapped to their bare number with a note naming the part.
#
# The amended-return lines 36 and 42 and the six voluntary fund lines 33a to
# 33f are not modelled.

form: "Form 1"
message_name: "nexteggapp.taxprotos.us.state.ma.v1.FormMA1"
tax_years: 2025

concepts {
  concept: "filing_status"
  years { tax_year: 2025 irs_box: "1" note: "Single, married filing jointly, married filing separately, head of household." }
}
