# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form IT-201: the return a full-year New York resident files.
proto_library(
    name = "form_it201_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_it201.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ny/v1/form_it201.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ny/v1/form_it201:__pkg__"],
)
