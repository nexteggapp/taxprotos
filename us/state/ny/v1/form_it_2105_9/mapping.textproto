# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form IT-2105.9 calls each concept, per tax year.
#
# Lines come from the 2025 Form IT-2105.9 as the New York State Department of
# Taxation and Finance publishes it, in testdata/. There are no amount codes:
# IRS Publication 1220 covers the information returns the IRS receives
# electronically, and a state form is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. The columns of lines 25 to 38 and Worksheet 1 of the
# instructions are repeated messages whose fields name their lines in their
# comments.

form: "IT-2105.9"
message_name: "nexteggapp.taxprotos.us.state.ny.v1.FormIt21059"
tax_years: 2025

concepts {
  concept: "total_tax"
  years { tax_year: 2025 irs_box: "1" }
}

