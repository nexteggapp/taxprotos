# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# Form IT-2105.9: underpayment of estimated tax by individuals and fiduciaries.
proto_library(
    name = "form_it_2105_9_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "form_it_2105_9.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# The mapping and the form extract it is checked against, for
# //go/us/state/ny/v1/form_it_2105_9.
filegroup(
    name = "test_oracles",
    srcs = glob([
        "mapping.textproto",
        "testdata/**",
    ]),
    visibility = ["//go/us/state/ny/v1/form_it_2105_9:__pkg__"],
)
