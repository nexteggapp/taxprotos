# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form IL-2210 calls each concept, per tax year.
#
# Lines come from the 2025 Form IL-2210 (R-12/25) as the Illinois Department
# of Revenue publishes it, in testdata/, which is pdftotext -layout over the
# PDF. The coverage test beside the Go package checks every line named here
# against that extract. Lines 1 to 3 have two columns, A for this year and B
# for the prior year, each its own concept. The quarters of lines 9a to 13,
# the payments of line 20, the rows of the penalty worksheets and the columns
# of Step 6 are repeated messages, whose lines their fields' comments name.
#
# There are no amount codes: IRS Publication 1220 covers the information
# returns the IRS receives electronically, and a state form is not one of
# them.

form: "IL-2210"
message_name: "nexteggapp.taxprotos.us.state.il.v1.FormIl2210"
tax_years: 2025

concepts {
