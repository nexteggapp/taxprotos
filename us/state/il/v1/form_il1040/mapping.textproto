# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form IL-1040 calls each concept, per tax year.
#
# Lines come from the 2025 Form IL-1040 as the Illinois Department of Revenue
# publishes it. There are no amount codes: IRS Publication 1220 covers the
# information returns the IRS receives electronically, and a state return is not
# one of them.
#
# The form prints the parts of line 10 as a bare "a" to "d" beside the number,
# so 10b and 10c never appear as such. They are mapped to line 10 with a note
# saying which part they are.

form: "IL-1040"
message_name: "nexteggapp.taxprotos.us.state.il.v1.FormIL1040"
tax_years: 2025

concepts {
  concept: "filing_status"
  years {
    tax_year: 2025
    irs_box: "B"
    note: "Step 1, item B: single, married filing jointly, married filing separately, widowed, head of household."
  }
}
concepts {
  concept: "claimed_as_dependent"
  years { tax_year: 2025 irs_box: "C" }
}
concepts {
