# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form W-2G calls each concept, per tax year.
#
# Boxes come from the 2025 Form W-2G box layout. Amount codes come from IRS
# Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document the
# coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "W-2G"
message_name: "nexteggapp.taxprotos.us.federal.v1.FormW2G"
tax_years: 2025

concepts {
  concept: "reportable_winnings"
  years {
    tax_year: 2025
    irs_box: "1"
    amount_code: "1"
  }
}

concepts {
  concept: "date_won"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "federal_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "4"
    amount_code: "2"
  }
}

unmapped_amount_codes {
  tax_year: 2025
  amount_code: "7"
  amount_type: "Winnings from identical wagers"
  reason: "Not read by a household's tax year yet, so the schema has no field for it."
}
