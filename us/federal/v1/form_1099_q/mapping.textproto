# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 1099-Q calls each concept, per tax year.
#
# Line numbers come from Form 1099-Q. Amount codes come from IRS Publication
# 1220 for Tax Year 2025.

form: "1099-Q"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1099Q"
tax_years: 2025

concepts {
  concept: "gross_distribution"
  years {
    tax_year: 2025
    irs_box: "1"
    amount_code: "1"
  }
}
concepts {
