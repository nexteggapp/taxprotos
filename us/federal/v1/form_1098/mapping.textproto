# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form 1098 calls each concept, per tax year.
#
# Boxes come from the Form 1098 (Rev. 4-2025) box layout. Amount codes come
# from IRS Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document
# the coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "1098"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1098"
tax_years: 2025

concepts {
  concept: "mortgage_interest_received"
  years {
    tax_year: 2025
    irs_box: "1"
    amount_code: "1"
  }
}
concepts {
  concept: "outstanding_mortgage_principal"
  years {
    tax_year: 2025
    irs_box: "2"
    amount_code: "6"
  }
}
concepts {
  concept: "mortgage_origination_date"
  years {
    tax_year: 2025
    irs_box: "3"
  }
}
concepts {
  concept: "refund_of_overpaid_interest"
  years {
    tax_year: 2025
    irs_box: "4"
    amount_code: "3"
  }
}
concepts {
  concept: "mortgage_insurance_premiums"
  years {
    tax_year: 2025
    irs_box: "5"
    amount_code: "4"
  }
}
concepts {
  concept: "points_paid_on_purchase_of_principal_residence"
  years {
    tax_year: 2025
    irs_box: "6"
    amount_code: "2"
  }
}
concepts {
  concept: "property_address_is_borrower_address"
  years {
    tax_year: 2025
    irs_box: "7"
  }
}
concepts {
  concept: "property_address_or_description"
  years {
    tax_year: 2025
    irs_box: "8"
  }
}
concepts {
  concept: "number_of_properties_securing_mortgage"
  years {
    tax_year: 2025
    irs_box: "9"
  }
}
concepts {
  concept: "other"
  years {
    tax_year: 2025
    irs_box: "10"
  }
}
concepts {
  concept: "mortgage_acquisition_date"
  years {
    tax_year: 2025
    irs_box: "11"
  }
}
unmapped_amount_codes {
  tax_year: 2025
  amount_code: "5"
  amount_type: "Blank (Filer's use)"
  reason: "Publication 1220 leaves this payment amount field to the filer. The form prints no box for it."
}
