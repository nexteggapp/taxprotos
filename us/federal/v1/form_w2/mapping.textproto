# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form W-2 calls each concept, per tax year.
#
# Boxes come from the 2025 Form W-2 box layout. Amount codes come from IRS
# Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document the
# coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "W-2"
message_name: "nexteggapp.taxprotos.us.federal.v1.FormW2"
tax_years: 2025

concepts {
  concept: "control_number"
  years {
    tax_year: 2025
    irs_box: "d"
  }
}
concepts {
  concept: "wages_tips_other_compensation"
  years {
    tax_year: 2025
    irs_box: "1"
  }
}
concepts {
  concept: "federal_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}
concepts {
  concept: "social_security_wages"
  years {
    tax_year: 2025
    irs_box: "3"
  }
}
concepts {
  concept: "social_security_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "4"
  }
}
concepts {
  concept: "medicare_wages_and_tips"
  years {
    tax_year: 2025
    irs_box: "5"
  }
}
concepts {
  concept: "medicare_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "6"
  }
}
concepts {
  concept: "social_security_tips"
  years {
    tax_year: 2025
    irs_box: "7"
  }
}
concepts {
  concept: "allocated_tips"
  years {
    tax_year: 2025
    irs_box: "8"
  }
}
concepts {
  concept: "dependent_care_benefits"
  years {
    tax_year: 2025
    irs_box: "10"
  }
}
concepts {
  concept: "nonqualified_plans"
  years {
    tax_year: 2025
    irs_box: "11"
  }
}
concepts {
  concept: "coded_amounts"
  years {
    tax_year: 2025
    irs_box: "12a-12d"
    note: "Four slots. Box 9 is blank on the 2025 form so that a fourth fits."
  }
}
concepts {
  concept: "statutory_employee"
  years {
    tax_year: 2025
    irs_box: "13"
  }
}
concepts {
  concept: "retirement_plan"
  years {
    tax_year: 2025
    irs_box: "13"
  }
}
concepts {
  concept: "third_party_sick_pay"
  years {
    tax_year: 2025
    irs_box: "13"
  }
}
concepts {
  concept: "other_items"
  years {
    tax_year: 2025
    irs_box: "14"
    note: "Renumbered 14a for tax year 2026, when box 14b was added for Treasury Tipped Occupation Codes."
  }
}
concepts {
  concept: "state_tax_withholding"
  years {
    tax_year: 2025
    irs_box: "15-17"
    note: "Two state blocks. Box 15 is the state and its number, 16 the state wages, 17 the state income tax."
  }
}
concepts {
  concept: "local_tax_withholding"
  years {
    tax_year: 2025
    irs_box: "18-20"
    note: "Two local blocks. Box 18 is the local wages, 19 the local income tax, 20 the locality."
  }
}
