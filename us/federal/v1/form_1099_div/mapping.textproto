# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form 1099-DIV calls each concept, per tax year.
#
# Boxes come from the Form 1099-DIV (Rev. 1-2024) box layout. Amount codes
# come from IRS Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same
# document the coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "1099-DIV"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1099DIV"
tax_years: 2025

concepts {
  concept: "ordinary_dividends"
  years {
    tax_year: 2025
    irs_box: "1a"
    amount_code: "1"
  }
}
concepts {
  concept: "qualified_dividends"
  years {
    tax_year: 2025
    irs_box: "1b"
    amount_code: "2"
  }
}
