# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form SSA-1099 calls each concept, per tax year.
#
# Boxes come from the 2025 Form SSA-1099 box layout. The Social Security
# Administration issues the form, and IRS Publication 1220 has no Amount Code
# table for it, so no concept here has an amount code.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "SSA-1099"
message_name: "nexteggapp.taxprotos.us.federal.v1.FormSSA1099"
tax_years: 2025

concepts {
  concept: "benefits_paid"
  years {
    tax_year: 2025
    irs_box: "3"
  }
}

concepts {
  concept: "benefits_repaid"
  years {
    tax_year: 2025
    irs_box: "4"
  }
}

concepts {
  concept: "net_benefits"
  years {
    tax_year: 2025
    irs_box: "5"
  }
}

concepts {
  concept: "federal_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "6"
  }
}
