# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form SSA-1099 calls each concept, per tax year.
#
# Boxes come from the 2025 Form SSA-1099 box layout. The Social Security
# Administration issues the form, and IRS Publication 1220 has no Amount Code
# table for it, so no concept here has an amount code.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "SSA-1099"
message_name: "nexteggapp.taxprotos.us.federal.v1.FormSSA1099"
tax_years: 2025

concepts {
  concept: "benefits_paid"
  years {
    tax_year: 2025
    irs_box: "3"
  }
}

concepts {
  concept: "benefits_repaid"
  years {
    tax_year: 2025
    irs_box: "4"
  }
}

concepts {
  concept: "net_benefits"
  years {
    tax_year: 2025
    irs_box: "5"
  }
}

concepts {
  concept: "federal_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "6"
  }
}

concepts {
  concept: "beneficiary.name"
  years {
    tax_year: 2025
    irs_box: "1"
  }
}

concepts {
  concept: "beneficiary.tin"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "beneficiary.address"
  years {
    tax_year: 2025
    irs_box: "7"
  }
}

concepts {
  concept: "claim_number"
  years {
    tax_year: 2025
    irs_box: "8"
  }
}

concepts {
  concept: "benefits_for_earlier_years"
  years {
    tax_year: 2025
    note: "The starred note under the description of box 3: \"Box 3 includes $ paid in 2025 for 2024, 2023, and other tax years\"."
  }
}

concepts {
  concept: "paid_by_check_or_direct_deposit"
  years {
    tax_year: 2025
    note: "A line of the description of box 3, without a number."
  }
}

concepts {
  concept: "medicare_part_b_premiums"
  years {
    tax_year: 2025
    note: "A line of the description of box 3, without a number."
  }
}

concepts {
  concept: "medicare_part_c_premiums"
  years {
    tax_year: 2025
    note: "A line of the description of box 3, without a number."
  }
}

concepts {
  concept: "medicare_part_d_premiums"
  years {
    tax_year: 2025
    note: "A line of the description of box 3, without a number."
  }
}

concepts {
  concept: "other_additions"
  years {
    tax_year: 2025
    note: "Lines of the description of box 3, without numbers."
  }
}

concepts {
  concept: "total_additions"
  years {
    tax_year: 2025
    note: "A line of the description of box 3, without a number."
  }
}

concepts {
  concept: "subtractions"
  years {
    tax_year: 2025
    note: "Lines of the description of box 3, without numbers."
  }
}

concepts {
  concept: "total_subtractions"
  years {
    tax_year: 2025
    note: "A line of the description of box 3, without a number. The line below it, \"Benefits for 2025\", repeats box 3."
  }
}

concepts {
  concept: "repayments"
  years {
    tax_year: 2025
    note: "Lines of the description of box 4, without numbers. The last, \"Benefits repaid to SSA in 2025\", repeats box 4."
  }
}
