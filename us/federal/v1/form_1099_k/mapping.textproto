# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form 1099-K calls each concept, per tax year.
#
# Boxes come from the Form 1099-K (Rev. 3-2024) box layout, with the 2026
# boxes from the Instructions for Form 1099-K (12/2026). Amount codes come
# from IRS Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document
# the coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "1099-K"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1099K"
tax_years: 2025

concepts {
  concept: "filer_type"
  years {
    tax_year: 2025
    note: "Printed in the left column without a number."
  }
}
concepts {
  concept: "transaction_type"
  years {
    tax_year: 2025
    note: "Printed in the left column without a number."
  }
}
concepts {
  concept: "payment_settlement_entity_name"
  years {
    tax_year: 2025
    note: "Printed in the left column without a number."
  }
}
concepts {
  concept: "payment_settlement_entity_telephone"
  years {
    tax_year: 2025
    note: "Printed in the left column without a number."
  }
}
concepts {
  concept: "gross_payment_transactions"
  years {
    tax_year: 2025
    irs_box: "1a"
    amount_code: "1"
  }
}
concepts {
  concept: "card_not_present_transactions"
  years {
    tax_year: 2025
    irs_box: "1b"
    amount_code: "2"
  }
}
concepts {
  concept: "cash_tips"
  years {
    tax_year: 2025
    absent: true
    note: "First reported for tax year 2026, in box 1c."
  }
}
concepts {
  concept: "tipped_occupation_codes"
  years {
    tax_year: 2025
    absent: true
    note: "First reported for tax year 2026, in box 1d."
  }
}
concepts {
  concept: "merchant_category_code"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}
concepts {
  concept: "payment_transaction_count"
  years {
    tax_year: 2025
    irs_box: "3"
  }
}
concepts {
  concept: "federal_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "4"
    amount_code: "4"
  }
}
concepts {
  concept: "monthly_amounts.january"
  years {
    tax_year: 2025
    irs_box: "5a"
    amount_code: "5"
  }
}
concepts {
  concept: "monthly_amounts.february"
  years {
    tax_year: 2025
    irs_box: "5b"
    amount_code: "6"
  }
}
concepts {
  concept: "monthly_amounts.march"
  years {
    tax_year: 2025
    irs_box: "5c"
    amount_code: "7"
  }
}
concepts {
  concept: "monthly_amounts.april"
  years {
    tax_year: 2025
    irs_box: "5d"
    amount_code: "8"
  }
}
concepts {
  concept: "monthly_amounts.may"
  years {
    tax_year: 2025
    irs_box: "5e"
    amount_code: "9"
  }
}
concepts {
  concept: "monthly_amounts.june"
  years {
    tax_year: 2025
    irs_box: "5f"
    amount_code: "A"
  }
}
concepts {
  concept: "monthly_amounts.july"
  years {
    tax_year: 2025
    irs_box: "5g"
    amount_code: "B"
  }
}
concepts {
  concept: "monthly_amounts.august"
  years {
    tax_year: 2025
    irs_box: "5h"
    amount_code: "C"
  }
}
concepts {
  concept: "monthly_amounts.september"
  years {
    tax_year: 2025
    irs_box: "5i"
    amount_code: "D"
  }
}
concepts {
  concept: "monthly_amounts.october"
  years {
    tax_year: 2025
    irs_box: "5j"
    amount_code: "E"
  }
}
concepts {
  concept: "monthly_amounts.november"
  years {
    tax_year: 2025
    irs_box: "5k"
    amount_code: "F"
  }
}
concepts {
  concept: "monthly_amounts.december"
  years {
    tax_year: 2025
    irs_box: "5l"
    amount_code: "G"
  }
}
concepts {
  concept: "state_tax_withholding"
  years {
    tax_year: 2025
    irs_box: "6-8"
    note: "Two state blocks. Box 6 is the state, 7 its number, 8 the tax withheld."
  }
}
