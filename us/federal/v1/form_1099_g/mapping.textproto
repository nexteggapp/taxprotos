# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form 1099-G calls each concept, per tax year.
#
# Boxes come from the 2025 Form 1099-G box layout. Amount codes come from IRS
# Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document the
# coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "1099-G"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1099G"
tax_years: 2025

concepts {
  concept: "unemployment_compensation"
  years {
    tax_year: 2025
    irs_box: "1"
    amount_code: "1"
  }
}

concepts {
  concept: "state_or_local_refund"
  years {
    tax_year: 2025
    irs_box: "2"
    amount_code: "2"
  }
}

concepts {
  concept: "refund_tax_year"
  years {
    tax_year: 2025
    irs_box: "3"
  }
}

concepts {
  concept: "federal_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "4"
    amount_code: "4"
  }
}

concepts {
  concept: "rtaa_payments"
  years {
    tax_year: 2025
    irs_box: "5"
    amount_code: "5"
  }
}

concepts {
  concept: "taxable_grants"
  years {
    tax_year: 2025
    irs_box: "6"
    amount_code: "6"
  }
}

concepts {
  concept: "agriculture_payments"
  years {
    tax_year: 2025
    irs_box: "7"
    amount_code: "7"
  }
}

concepts {
  concept: "refund_is_trade_or_business_income"
  years {
    tax_year: 2025
    irs_box: "8"
  }
}

concepts {
  concept: "market_gain"
  years {
    tax_year: 2025
    irs_box: "9"
    amount_code: "9"
  }
}

concepts {
  concept: "state_tax_withholding"
  years {
    tax_year: 2025
    irs_box: "10a-11"
    note: "Two state blocks. Boxes 10a, 10b and 11 make up one row, and the form prints the row twice."
  }
}
