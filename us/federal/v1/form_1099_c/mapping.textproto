# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What Form 1099-C calls each concept, per tax year.
#
# Line numbers come from Form 1099-C. Amount codes come from IRS Publication
# 1220 for Tax Year 2025.

