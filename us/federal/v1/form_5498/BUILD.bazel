# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

proto_library(
    name = "form_5498_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    # Without it the path would be the module-root-relative common/v1/... and
    # would collide with any other module that has a common/v1.
    import_prefix = "taxprotos",
    srcs = ["form_5498.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
    ],
)

# mapping.textproto is read by //go/us/federal/v1/pub1220.
exports_files([
    "mapping.textproto",
])
