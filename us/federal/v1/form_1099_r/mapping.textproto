# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form 1099-R calls each concept, per tax year.
#
# Boxes come from the 2025 Form 1099-R box layout. Amount codes come from IRS
# Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document the
# coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "1099-R"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1099R"
tax_years: 2025

concepts {
  concept: "gross_distribution"
  years {
    tax_year: 2025
    irs_box: "1"
    amount_code: "1"
  }
}
concepts {
  concept: "taxable_amount"
  years {
    tax_year: 2025
    irs_box: "2a"
    amount_code: "2"
  }
}
concepts {
  concept: "taxable_amount_not_determined"
  years {
    tax_year: 2025
    irs_box: "2b"
  }
}
concepts {
  concept: "total_distribution"
  years {
    tax_year: 2025
    irs_box: "2b"
  }
}
concepts {
  concept: "capital_gain"
  years {
    tax_year: 2025
    irs_box: "3"
    amount_code: "3"
  }
}
concepts {
  concept: "federal_tax_withheld"
  years {
    tax_year: 2025
    irs_box: "4"
    amount_code: "4"
  }
}
concepts {
  concept: "employee_contributions"
  years {
    tax_year: 2025
    irs_box: "5"
    amount_code: "5"
  }
}
concepts {
  concept: "net_unrealized_appreciation"
  years {
    tax_year: 2025
    irs_box: "6"
    amount_code: "6"
  }
}
concepts {
  concept: "distribution_codes"
  years {
    tax_year: 2025
    irs_box: "7"
  }
}
concepts {
  concept: "ira_sep_simple"
  years {
    tax_year: 2025
    irs_box: "7"
  }
}
concepts {
  concept: "other_amount"
  years {
    tax_year: 2025
    irs_box: "8"
    amount_code: "8"
  }
}
concepts {
  concept: "other_percentage"
  years {
    tax_year: 2025
    irs_box: "8"
  }
}
concepts {
  concept: "percentage_of_total_distribution"
  years {
    tax_year: 2025
    irs_box: "9a"
  }
}
concepts {
  concept: "total_employee_contributions"
  years {
    tax_year: 2025
    irs_box: "9b"
    amount_code: "9"
  }
}
concepts {
  concept: "amount_allocable_to_irr_within_five_years"
  years {
    tax_year: 2025
    irs_box: "10"
    amount_code: "B"
  }
}
concepts {
  concept: "first_year_of_designated_roth_contributions"
  years {
    tax_year: 2025
    irs_box: "11"
  }
}
concepts {
  concept: "fatca_filing_requirement"
  years {
    tax_year: 2025
    irs_box: "12"
  }
}
concepts {
  concept: "date_of_payment"
  years {
    tax_year: 2025
    irs_box: "13"
  }
}
concepts {
  concept: "state_tax_withholding"
  years {
    tax_year: 2025
    irs_box: "14-16"
    note: "Two state blocks. Box 14 is the tax withheld, 15 the state and its number, 16 the distribution."
  }
}
concepts {
  concept: "local_tax_withholding"
  years {
    tax_year: 2025
    irs_box: "17-19"
    note: "Two local blocks. Box 17 is the tax withheld, 18 the locality, 19 the distribution."
  }
}
unmapped_amount_codes {
  tax_year: 2025
  amount_code: "A"
  amount_type: "Traditional IRA/SEP/SIMPLE distribution or Roth conversion"
  reason: "An electronic filer repeats the box 1 amount here when the IRA/SEP/SIMPLE checkbox is set. The form prints no box for it."
}
