# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form 1099-B calls each concept, per tax year.
#
# Boxes come from the 2025 Form 1099-B box layout. Amount codes come from IRS
# Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document the
# coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "1099-B"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1099B"
tax_years: 2025

concepts {
  concept: "form_8949_checkbox"
  years {
    tax_year: 2025
    note: "Printed top right without a number."
  }
}
concepts {
  concept: "description_of_property"
  years {
    tax_year: 2025
    irs_box: "1a"
  }
}
concepts {
  concept: "date_acquired"
  years {
    tax_year: 2025
    irs_box: "1b"
  }
}
