# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# Which printed line each concept sits on, for Form 8949.
#
# Lines come from the 2025 form in testdata/, which is pdftotext -layout over
# the PDF the IRS publishes. The coverage test beside this file checks every
# line named here against that extract.
#
# No amount codes: Publication 1220 covers the information returns the IRS
# receives electronically, and a return is not one of them.
#
# Field names on the message never carry a line number, per
# docs/form-schemas.md. This file is where those live.

form: "Form 8949"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form8949"
tax_years: 2025

concepts {
  concept: "total_short_term_proceeds"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "total_short_term_cost_or_other_basis"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "total_short_term_adjustments"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "total_short_term_gain_or_loss"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "total_long_term_proceeds"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "total_long_term_cost_or_other_basis"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "total_long_term_adjustments"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}

concepts {
  concept: "total_long_term_gain_or_loss"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}
