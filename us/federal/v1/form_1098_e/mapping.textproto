# proto-message: nexteggapp.taxprotos.common.v1.FormMapping
#
# What the Form 1098-E calls each concept, per tax year.
#
# Boxes come from the 2025 Form 1098-E box layout. Amount codes come from IRS
# Publication 1220 for Tax Year 2025 (Rev. 5-2026), the same document the
# coverage test in go/us/federal/v1/pub1220 reads.
#
# Field names on the message never carry a box number or an amount code, per
# docs/form-schemas.md. This file is where those live.

form: "1098-E"
message_name: "nexteggapp.taxprotos.us.federal.v1.Form1098E"
tax_years: 2025

concepts {
  concept: "student_loan_interest_received"
  years {
    tax_year: 2025
    irs_box: "1"
    amount_code: "1"
  }
}
concepts {
  concept: "excludes_origination_fees_and_capitalized_interest"
  years {
    tax_year: 2025
    irs_box: "2"
  }
}
