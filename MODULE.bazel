"""taxprotos: protobuf schemas for US tax forms."""

module(
    name = "nexteggapp_taxprotos",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_proto", version = "7.1.0")

# The schema packages load only protobuf rules, so a consumer needs no Go
# toolchain. The Go bindings and the test suites that check the schemas live
# under go/, the only part of the tree that loads rules_go, so rules_go,
# gazelle and go_deps are development dependencies: present when this module
# is the root, absent when it is somebody else's. A consumer therefore cannot
# build @nexteggapp_taxprotos//go/...; it generates its own bindings from the
# proto_library targets.
bazel_dep(name = "rules_go", version = "0.62.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.52.2", dev_dependency = True)

# The generated Go packages need protobuf's runtime, and the tests need
# prototext, protoreflect and protocompile. The versions are in go.mod.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_bufbuild_protocompile", "org_golang_google_protobuf")
