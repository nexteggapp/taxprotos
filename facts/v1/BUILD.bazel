# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")

# TaxYearFacts, one household's own facts for one tax year, and the document
# messages and refs it and a calculator's models use. See
# docs/facts.md.
proto_library(
    name = "facts_proto",
    # Imported as taxprotos/..., so consumers import these files by that path.
    import_prefix = "taxprotos",
    srcs = [
        "documents.proto",
        "tax_year_facts.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//common/v1:common_proto",
        "//us/federal/v1/form_1040:form_1040_proto",
        "//us/federal/v1/form_1095_a:form_1095_a_proto",
        "//us/federal/v1/form_1098:form_1098_proto",
        "//us/federal/v1/form_1098_e:form_1098_e_proto",
        "//us/federal/v1/form_1098_t:form_1098_t_proto",
        "//us/federal/v1/form_1099_b:form_1099_b_proto",
        "//us/federal/v1/form_1099_c:form_1099_c_proto",
        "//us/federal/v1/form_1099_div:form_1099_div_proto",
        "//us/federal/v1/form_1099_g:form_1099_g_proto",
        "//us/federal/v1/form_1099_int:form_1099_int_proto",
        "//us/federal/v1/form_1099_k:form_1099_k_proto",
        "//us/federal/v1/form_1099_misc:form_1099_misc_proto",
        "//us/federal/v1/form_1099_nec:form_1099_nec_proto",
        "//us/federal/v1/form_1099_oid:form_1099_oid_proto",
        "//us/federal/v1/form_1099_patr:form_1099_patr_proto",
        "//us/federal/v1/form_1099_q:form_1099_q_proto",
        "//us/federal/v1/form_1099_r:form_1099_r_proto",
        "//us/federal/v1/form_1099_s:form_1099_s_proto",
        "//us/federal/v1/form_1099_sa:form_1099_sa_proto",
        "//us/federal/v1/form_3921:form_3921_proto",
        "//us/federal/v1/form_3922:form_3922_proto",
        "//us/federal/v1/form_5498:form_5498_proto",
        "//us/federal/v1/form_5498_sa:form_5498_sa_proto",
        "//us/federal/v1/form_8889:form_8889_proto",
        "//us/federal/v1/form_ssa_1099:form_ssa_1099_proto",
        "//us/federal/v1/form_w2:form_w2_proto",
        "//us/federal/v1/form_w2g:form_w2g_proto",
        "//us/federal/v1/schedule_k1:schedule_k1_proto",
        "//us/state/ca/v1/form_540:form_540_proto",
        "//us/state/or/v1/form_or40:form_or40_proto",
    ],
)

# The sources, for //go/facts/v1's check that every element has a doc
# comment, which needs them because compiled descriptors carry no comments.
exports_files([
    "documents.proto",
    "tax_year_facts.proto",
])
